# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Never prefix this with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Vercel Cron uses this server-only secret in the Authorization header.
# Generate a random value with at least 16 characters.
CRON_SECRET=

# Optional: enables live game search. Manual game creation works without these values.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
